{
  "input": "yolo26_onnx/yolo26n_obb_qat_smoke_slim.onnx",
  "output_dir": "./output_yolo26n_obb_qat_smoke",
  "model_type": "QuantONNX",
  "target_hardware": "AX650",
  "npu_mode": "NPU3",
  "quant": {
    "input_configs": [
      {
        "tensor_name": "DEFAULT",
        "calibration_dataset": "/path/to/dataset",
        "calibration_size": 32,
        "calibration_mean": [0, 0, 0],
        "calibration_std": [1.0, 1.0, 1.0],
        "calibration_format": "Binary"
      }
    ],
    "layer_configs": [
      {
        "op_type": "Silu",
        "data_type": "U8"
      }
    ],
    "conv_bias_data_type": "FP32",
    "precision_analysis": true,
    "precision_analysis_method": "PerLayer",
    "precision_analysis_mode": "NPUBackend"
  },
  "input_processors": [
    {
      "tensor_name": "DEFAULT",
      "tensor_layout": "NCHW",
      "src_layout": "NCHW",
      "src_dtype": "FP32",
      "mean": [0, 0, 0],
      "std": [1, 1, 1]
    }
  ],
  "output_processors": [],
  "compiler": {
    "check": 2
  }
}
